{
	email admin@uni.home.arpa
}

hs.uni.home.arpa {
	# Explicit ACME issuer: Caddy treats .home.arpa as non-public and would otherwise
	# silently use its internal CA instead of the simulated university ACME server.
	tls {
		issuer acme {
			dir https://ca.uni.home.arpa/acme/acme/directory
			trusted_roots /etc/caddy/sim-root.crt
		}
	}
	reverse_proxy 127.0.0.1:8080
}
