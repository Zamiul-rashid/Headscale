{
 "uid": "hs-sim",
 "title": "hs-sim \u2014 Headscale pilot simulation",
 "tags": [
  "hs-sim"
 ],
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Headscale up",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"hs-sim-headscale\"}"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Registered nodes",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "headscale_nodestore_nodes{job=\"hs-sim-headscale\"}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Uptime % (24h)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100*avg_over_time(up{job=\"hs-sim-headscale\"}[24h])"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Process RSS",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "process_resident_memory_bytes{job=\"hs-sim-headscale\"}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Nodes over time",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "headscale_nodestore_nodes{job=\"hs-sim-headscale\"}",
     "legendFormat": "nodes"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Headscale CPU",
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(process_cpu_seconds_total{job=\"hs-sim-headscale\"}[5m])",
     "legendFormat": "cpu s/s"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Nodestore ops/s",
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(headscale_nodestore_operations_total{job=\"hs-sim-headscale\"}[5m]))",
     "legendFormat": "ops"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Server CPU busy",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1-avg(rate(node_cpu_seconds_total{job=\"hs-sim-node\",mode=\"idle\"}[5m]))",
     "legendFormat": "busy"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Server memory used",
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes{job=\"hs-sim-node\"}-node_memory_MemAvailable_bytes{job=\"hs-sim-node\"}",
     "legendFormat": "used"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Server network",
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{job=\"hs-sim-node\",device=\"eth0\"}[5m])",
     "legendFormat": "rx"
    },
    {
     "refId": "B",
     "expr": "rate(node_network_transmit_bytes_total{job=\"hs-sim-node\",device=\"eth0\"}[5m])",
     "legendFormat": "tx"
    }
   ]
  }
 ]
}